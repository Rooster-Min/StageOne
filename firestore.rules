rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  match /usuarios/{uid} {
   allow read: if signed();
   allow create, update: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','bio','role','avatarStyle']);
  }
  match /publicaciones/{id} {
   allow read: if signed() && resource.data.visibility == 'public';
   allow create: if signed() && request.resource.data.ownerId == request.auth.uid && request.resource.data.visibility == 'public';
   allow update: if signed() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid && request.resource.data.visibility == 'public';
   allow delete: if signed() && resource.data.ownerId == request.auth.uid;
  }
 }
}
